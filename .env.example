# Public site URL (used for canonical links, sitemap and schema). PLACEHOLDER until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where quote requests get delivered. Any service that accepts a JSON POST works
# (Zapier/Make webhook, Formspree endpoint, your own email function).
# If this is empty, quote requests are only written to the server log and NOT delivered.
QUOTE_WEBHOOK_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional.
# When set, a consent banner appears and GA loads ONLY after the visitor clicks Accept.
# When empty, no analytics and no banner.
NEXT_PUBLIC_GA_ID=
